{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "scripts",
    "outDir": "dist/scripts",

    "strict": true,
    "noEmitOnError": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
